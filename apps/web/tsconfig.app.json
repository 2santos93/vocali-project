{
  // The application shell: pages, layouts, route middleware and composables.
  //
  // Unlike the design system, these are allowed to use the Nuxt runtime, so
  // they compile against Nuxt's generated types and get `$fetch`,
  // `definePageMeta`, `navigateTo`, `useState` and the auto-imported
  // components typed rather than declared by hand.
  //
  // `.nuxt/tsconfig.app.json` is generated by `nuxt prepare`, which this
  // package runs on `postinstall`. The relative paths inside it resolve
  // against `.nuxt/`, not against this file, which is why extending it works
  // from here at all.
  "extends": "./.nuxt/tsconfig.app.json",

  // The generated config sets `types: []`, which is right for application code
  // — nothing here should see Node's globals — but it also removes Jest's, and
  // the composables under `app/composables` are tested. Naming Jest and
  // nothing else keeps `describe` and `expect` resolvable without letting
  // `process` and `Buffer` back into code that runs in a browser.
  "compilerOptions": { "types": ["jest"] },

  // The generated config includes all of `app/**`. Narrowing it to everything
  // *except* the components keeps each file in exactly one project: the
  // components are checked without the Nuxt types, which is the whole point of
  // `tsconfig.json`, and checking them again with those types available would
  // not undo that but would need `@types/jest` here to compile their tests.
  // The components are still checked against the pages that use them —
  // `#components` imports them, so they enter this program by reference.
  "include": [".nuxt/nuxt.d.ts", "app/**/*.ts", "app/**/*.vue"],
  // `app/i18n` is excluded for the same reason `app/components` is: it is a
  // root file of the Nuxt-free project, and one file in two projects is one
  // file with two answers to whether `useCookie` exists.
  "exclude": ["node_modules", ".output", "coverage", "cypress", "app/components/**", "app/i18n/**"]
}
