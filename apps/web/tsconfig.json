{
  // The design system's project, and deliberately standalone: it does not
  // extend `.nuxt/tsconfig.json`.
  //
  // Atoms, molecules and organisms are pure Vue with no Nuxt runtime, so they
  // must compile without Nuxt's generated types. Typing them against those
  // types would make an accidental `useFetch` or `navigateTo` compile happily
  // and only fail later, under Jest, where no Nuxt runtime exists. Here it
  // fails at `pnpm typecheck` instead, which is the earliest place it can.
  //
  // Pages, layouts, middleware and composables do need those types, and now
  // have them: `tsconfig.app.json`. Server routes have `tsconfig.server.json`.
  // Both extend a generated config, which is why `nuxt prepare` runs from this
  // package's `postinstall` — lint and typecheck both read those files, and a
  // fresh clone must not have to know that.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    // The base config turns declarations on for the packages that will be
    // published into a bundle. Nothing consumes this package's types, and
    // leaving it on makes TypeScript enforce that every inferred type could be
    // *named* in a .d.ts — which pnpm's nested store makes impossible for
    // `defineNuxtConfig`'s return type (TS2742) without a hand-written
    // annotation that says nothing.
    "declaration": false,
    "jsx": "preserve",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["jest", "node"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["./app/*"]
    }
  },
  // Only `app/components`. Widening this to `app/**` would sweep up the pages
  // and lose the property the file exists for, since a page legitimately calls
  // `navigateTo` and would then have to be excluded one by one.
  //
  // Cypress is deliberately absent, and lives in `tsconfig.cypress.json`.
  // Importing the `cypress` package installs Mocha and Chai globals, which
  // then shadow Jest's: `expect(...).toBe` stops existing and every component
  // test fails to compile against an assertion library it does not use.
  // `app/i18n` belongs to this project rather than to the shell's. The
  // components import it, so it has to compile without Nuxt's types for the
  // same reason they do — and being a root file here is what makes ESLint's
  // project service resolve it, rather than reporting a parse error for a file
  // that belongs to no program.
  "include": [
    "app/components/**/*.ts",
    "app/components/**/*.vue",
    "app/i18n/**/*.ts",
    "nuxt.config.ts"
  ],
  "exclude": ["node_modules", ".nuxt", ".output", "coverage", "cypress"]
}
