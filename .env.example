# Copy to .env and fill in.
#
# Nothing here is a secret. The two credentials this platform uses are read at
# runtime from Parameter Store, so every credential below appears as the PATH
# to a secret and never as its value.
#
# apps/api/src/infrastructure/config/environment.ts validates the API block at
# container start-up, so a missing variable fails the deploy instead of a
# user's first request.

# ---------------------------------------------------------------------------
# API (AWS Lambda)
# ---------------------------------------------------------------------------

# Supplied by the Lambda runtime, and a function definition cannot set it.
# It still has to be provided by hand for a local script or a test run.
AWS_REGION=eu-west-1

# Two buckets, deliberately. They are separate grants in every role, so writing
# a transcript into the audio bucket is denied by IAM at the moment of the
# write, after the provider has already transcribed and billed for the job.
AUDIO_BUCKET_NAME=
TRANSCRIPTS_BUCKET_NAME=

TRANSCRIPTIONS_TABLE_NAME=

# Parameter Store paths, never the secrets themselves. The values live in SSM
# as SecureString parameters and are decrypted at runtime.
SPEECHMATICS_API_KEY_PARAMETER=/vocali/speechmatics/api-key
SPEECHMATICS_WEBHOOK_SECRET_PARAMETER=/vocali/speechmatics/webhook-secret

# Origin the provider calls back on when a job finishes. Base only: no path
# and no query string; each job's identity is appended to it. Must be an
# absolute URL, and must be reachable from the public internet, which a
# localhost address is not.
PROVIDER_CALLBACK_BASE_URL=

# Optional. The values shown are the defaults the config module already
# applies, so an absent variable behaves exactly like the line below.
PROVIDER_REQUEST_TIMEOUT_MS=10000
PROVIDER_MAX_ATTEMPTS=3
# One of: error, warn, info, debug, trace
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Front end (Nuxt server)
# ---------------------------------------------------------------------------
# Nuxt derives these names from the runtimeConfig block in apps/web/nuxt.config.ts.
# Every one is read on the SERVER only. There is no `public` block, because the
# whole authentication design rests on the browser never holding a Cognito
# credential, and a value placed there would be inlined into the client bundle.
#
# All five are required: the server throws on start-up if any is left empty.

# Where the Nuxt server forwards API calls. The browser never sees this value;
# it talks only to the Nuxt server, which proxies onward.
NUXT_API_BASE_URL=

NUXT_COGNITO_REGION=eu-west-1
NUXT_COGNITO_USER_POOL_ID=
NUXT_COGNITO_CLIENT_ID=

# A Parameter Store path again, not the secret. The Cognito client secret is
# never an environment variable. It is read and decrypted at runtime, the same
# arrangement the API uses for the provider key.
NUXT_COGNITO_CLIENT_SECRET_PARAMETER=/vocali/cognito/client-secret
