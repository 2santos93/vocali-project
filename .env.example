AWS_REGION=eu-west-1
AUDIO_BUCKET_NAME=
TRANSCRIPTIONS_TABLE_NAME=

# Parameter Store paths, never the secrets themselves. The values live in SSM
# as SecureString parameters and are read at runtime.
SPEECHMATICS_API_KEY_PARAMETER=/vocali/speechmatics/api-key
SPEECHMATICS_WEBHOOK_SECRET_PARAMETER=/vocali/speechmatics/webhook-secret

PROVIDER_CALLBACK_BASE_URL=

# Optional; the defaults below are what the config module applies.
PROVIDER_REQUEST_TIMEOUT_MS=10000
PROVIDER_MAX_ATTEMPTS=3
LOG_LEVEL=info
